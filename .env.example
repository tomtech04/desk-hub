# Desk Hub config. Copy to .env on the Pi and fill in what you want.
# Anything left blank just shows a "not set up yet" card.

PORT=8080
# Your timezone (defaults to the Pi's system timezone)
# TZ_NAME=America/New_York

# --- Weather (Open-Meteo, no key needed). Defaults to Georgia Tech. ---
WEATHER_LAT=33.7756
WEATHER_LON=-84.3963
WEATHER_UNITS=fahrenheit

# --- PayIt (Supabase) ---------------------------------------------------
# Preferred: a login as the read-only `deskhub_reader` role. Set up by
# scripts/setup-readonly-db.sh, which fills these two in for you.
PAYIT_DATABASE_URL=
# User ids of team/test accounts (admin panel's TEST_ACCOUNT_EMAILS): their
# businesses, and admin-ignored transactions, don't count as revenue.
PAYIT_TEST_OWNER_IDS=
# Platform profit (optional): the application fees Stripe actually paid the
# platform, as in the admin panel. Create a RESTRICTED key in the Stripe
# dashboard (Developers -> API keys -> Create restricted key) with only
# "Application Fees: Read". It starts with rk_live_.
STRIPE_RESTRICTED_KEY=
# Connected accounts to leave out of profit (team/test), comma-separated acct_ ids
PAYIT_EXCLUDE_STRIPE_ACCOUNTS=

# Fallback: the Supabase URL + service key (full access; avoid).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYIT_TEST_ACCOUNT_EMAILS=
# Any extra business ids to leave out (comma-separated)
PAYIT_EXCLUDE_BUSINESS_IDS=
# Payment methods left out of the hub's PayIt numbers (comma-separated). Defaults to cash;
# set it to nothing (PAYIT_EXCLUDE_PROVIDERS=) to count every method.
# PAYIT_EXCLUDE_PROVIDERS=cash

# --- Mail (IMAP, one block per account) ---------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as PASS.
MAIL_1_NAME=Personal
MAIL_1_HOST=imap.gmail.com
MAIL_1_USER=
MAIL_1_PASS=
MAIL_1_MAILBOX=INBOX

# School mail: see README ("School email") for the options.
# MAIL_2_NAME=School
# MAIL_2_HOST=imap.gmail.com
# MAIL_2_USER=
# MAIL_2_PASS=
# MAIL_2_MAILBOX=GT

# School / work Microsoft 365 mail (when IMAP passwords and forwarding are
# blocked). Register an app in your organization's Entra ID (see README), put
# its Application (client) ID here, then tap Connect in Settings and enter the
# code on your phone. Read-only; the hub never sees the account password.
MS_CLIENT_ID=
MS_TENANT=gatech.edu
MS_NAME=School

# Which mail the hub looks at: MAIL_n_MAILBOX can be a Gmail label instead of
# INBOX. Make a label (say "Hub"), add Gmail filters that apply it to the mail
# you want checked, and set MAIL_1_MAILBOX=Hub. Everything else is ignored.
#
# Automated mail (security alerts, sign-in notices, receipts, newsletters) is
# never turned into tasks. Add your own rules in plain English if you like:
# MAIL_TASK_IGNORE=anything from LinkedIn or Upwork, recruiting emails

# Claude writes the one-line summaries + urgency. Without a key, the hub
# still shows mail with a plain preview instead.
ANTHROPIC_API_KEY=
# Haiku 4.5 is the default (cheapest). For a sharper digest only:
# DIGEST_MODEL=claude-sonnet-5-5
# CLAUDE_MODEL=claude-haiku-4-5
# MAIL_CONTEXT=a university student who also runs a small software startup

# --- Calendar (ICS feeds) -----------------------------------------------
# Name|URL pairs, comma-separated. Canvas: Calendar → "Calendar Feed".
# Google: Settings → your calendar → "Secret address in iCal format".
CALENDAR_FEEDS=
# Your own addresses on those calendars (comma-separated), so an event can show your reply.
CALENDAR_EMAILS=

# --- Phone / laptop access ------------------------------------------------
# The desk screen never needs to sign in. With a password set, every other
# device signs in once (remembered for 30 days). Without one, devices on your
# home Wi-Fi get in freely and anything coming through a tunnel is refused.
# Required before putting the hub behind a public URL. Make it long.
HUB_PASSWORD=

# --- Voice notes (Pebble Index 01 ring) ------------------------------------
# A long random token. In the Pebble app: Index 01 Settings -> Webhook, set
# the URL to https://<your hub address>/api/voice and add a header named
# Authorization with the value "Bearer <this token>". Send transcription only.
HUB_VOICE_TOKEN=

# --- Claude connector (MCP) -------------------------------------------------
# Lets Claude add tasks, notes and finished work to the hub. A long random
# token; scripts/connect-claude.sh creates one and connects Claude Code for you.
HUB_MCP_TOKEN=

# --- Push notifications -------------------------------------------------
# If set, POST /api/notify requires "Authorization: Bearer <token>".
HUB_NOTIFY_TOKEN=
